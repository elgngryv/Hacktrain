# External PostgreSQL and Redis reachable from the backend host.
# Use different migration and runtime roles. Runtime must not own tables or bypass RLS.
DB_URL=jdbc:postgresql://your-postgres-host:5432/hacktrain?sslmode=verify-full
DB_USER=hacktrain_runtime
DB_PASSWORD=
MIGRATION_DB_USER=hacktrain_migrator
MIGRATION_DB_PASSWORD=
REDIS_URL=rediss://:password@your-redis-host:6379

# Generate a base64-encoded 32-byte signing key. Never put this in the frontend.
JWT_SECRET=
FRONTEND_URL=https://your-frontend-domain.com
# Exact origins, comma-separated if multiple. No wildcard or trailing slash.
CORS_ORIGINS=https://your-frontend-domain.com
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq

GROQ_MODEL=openai/gpt-oss-20b
AI_STUDENT_DAILY_LIMIT=30
AI_ORGANIZATION_DAILY_LIMIT=1000


# Behind the deployment host's HTTPS reverse proxy.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8081
